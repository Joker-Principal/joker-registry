{
  "name": "jk",
  "version": "2.5.0",
  "description": "Joker's C++ Kit",
  "homepage": "https://github.com/Joker-Principal/jk",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "cxx23": {
      "description": "Build and consume jk with C++23 instead of the default C++20"
    },
    "log": {
      "description": "spdlog support",
      "dependencies": [
        "fmt",
        {
          "name": "spdlog",
          "features": [
            "fmt",
            "tz-offset",
            "wchar"
          ]
        }
      ]
    },
    "sqlite": {
      "description": "sqlite3 support",
      "dependencies": [
        "sqlite3"
      ]
    }
  }
}
