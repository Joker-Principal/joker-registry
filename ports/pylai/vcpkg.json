{
  "name": "pylai",
  "version": "0.1.8",
  "description": "HTTP server framework built on standalone asio and C++20 modules",
  "homepage": "https://github.com/Joker-Principal/pylai",
  "dependencies": [
    {
      "name": "asio",
      "features": [
        "spawn"
      ]
    },
    "fmt",
    "jk",
    {
      "name": "liburing",
      "platform": "linux"
    },
    "llhttp",
    "plf-hive",
    "spdlog",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
