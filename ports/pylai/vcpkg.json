{
  "name": "pylai",
  "version": "0.2.1",
  "description": "HTTP server framework built on standalone asio and C++20 modules",
  "homepage": "https://github.com/Joker-Principal/pylai",
  "dependencies": [
    {
      "name": "asio",
      "features": [
        "io-uring",
        "ssl"
      ]
    },
    {
      "name": "jk",
      "features": [
        "log"
      ]
    },
    "llhttp",
    "plf-hive",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
